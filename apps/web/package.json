{
  "name": "@gecko-advisor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:check": "next build 2>&1 | tee build-output.log && npx tsx scripts/check-seo-bundle-size.ts",
