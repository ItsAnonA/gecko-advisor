generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === String-to-Enum Conversions (Issue #49) ===

enum ScanStatus {
  queued
  running
  done
  error
}

enum ScanTargetType {
  url
  app
  address
}

enum ScanSource {
  manual
  manual_force
  stub
  batch
  admin_bulk
  scan_queue
  rescan_orphan
  retry_failed
}

enum EvidenceKind {
  tracker
  cookie
  header
  insecure
  thirdparty
  policy
  tls
  fingerprint
  mixed_content
  third_party_tracker
}

enum IndexTier {
  A
  B
  C
}

enum BatchStatus {
  running
  completed
  failed
}

enum NarrativeStatus {
  approved
  blocked
  error
  skipped
}

enum NarrativeScope {
  INSIGHT
  WEEKLY
}

// Existing enums
enum IssueSeverity {
  info
  low
  medium
  high
  critical
}

// New enums for Freemium model
enum Subscription {
  FREE
  PRO
  TEAM
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum AuthMethod {
  EMAIL
  WALLET
  BOTH
}

enum CheckFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// Phase 3: Change Intelligence
enum ChangeType {
  NONE     // No significant change
  MINOR    // 2-5 point delta
  MODERATE // 6-15 points
  MAJOR    // 16-25 points
  CRITICAL // >25 or fingerprinting toggle
}

// Phase 3C: Insight Engine
enum DomainTrend {
  IMPROVING
  STABLE
  DECLINING
  VOLATILE
}

enum PeriodType {
  WEEKLY
  MONTHLY
}

enum TrendDirection {
  UP
  DOWN
  FLAT
}

enum InsightType {
  DOMAIN_IMPROVEMENT
  DOMAIN_REGRESSION
  CATEGORY_TREND
  TRACKER_SURGE
  TRACKER_DECLINE
  FINGERPRINTING_SHIFT
  ANOMALY
  WEEKLY_SUMMARY
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Phase 3C Observation: Truth-Centric Metrics
enum InsightOutcome {
  PENDING      // Outcome not yet determined
  CONFIRMED    // Prediction/insight was correct
  PARTIAL      // Partially correct
  REVERSED     // Prediction was wrong
  INCONCLUSIVE // Cannot determine
  SUPERSEDED   // Replaced by newer insight
}

enum StabilityConfidenceTier {
  FULL        // 3+ scans, 30+ days span
  PARTIAL     // 2 scans, 14+ days span
  PROVISIONAL // 1 scan only
}

// New User model for authentication and subscriptions
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String? // Optional for email-only accounts
  emailVerified Boolean    @default(false)
  authMethod    AuthMethod @default(EMAIL)

  // Subscription
  subscription       Subscription       @default(FREE)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionEndsAt DateTime?

  // API Access
  apiKey        String?   @unique
  apiCallsMonth Int       @default(0)
  apiResetAt    DateTime?

  // Relations
  scans                Scan[]
  watchedUrls          WatchedUrl[]
  walletLink           WalletLink?
  passwordResetTokens  PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([apiKey])
}

// Enhanced Scan model with user relations and privacy controls
model Scan {
  id              String    @id @default(cuid())
  targetType      ScanTargetType
  input           String
  normalizedInput String?
  status          ScanStatus
  score           Int?
  label           String?
  progress        Int @default(0)
  summary         String?
  startedAt       DateTime?
  finishedAt      DateTime?
  slug            String    @unique
  source          ScanSource @default(manual)
  dedupeOfId      String?
  shareMessage    String?
  meta            Json?

  // New Freemium fields
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  isPublic  Boolean @default(true) // Pro users can make scans private
  isProScan Boolean @default(false) // Track if scan was performed with Pro features
  scannerIp String? // Track anonymous scans for rate limiting

  // Wall-clock scan duration in milliseconds (start to completion/failure)
  durationMs Int?

  // Domain Intelligence Engine: Direct domain link for volatility queries
  domainId String?
  domain   Domain? @relation("DomainScans", fields: [domainId], references: [id], onDelete: SetNull)

  evidence  Evidence[]
  issues    Issue[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  dedupeOf     Scan?  @relation("ScanDedupe", fields: [dedupeOfId], references: [id])
  dedupedScans Scan[] @relation("ScanDedupe")

  // Back-reference for Domain.latestScan relation
  domainLatest Domain? @relation("DomainLatestScan")

  // Phase 3: Change Intelligence relations
  changesAsCurrent  DomainChange[] @relation("DomainChangeCurrentScan")
  changesAsPrevious DomainChange[] @relation("DomainChangePreviousScan")

  // Optimized indexes for critical performance paths
  @@index([normalizedInput, status, finishedAt(sort: Desc)], map: "Scan_dedupe_lookup_idx")
  @@index([status, createdAt(sort: Desc)], map: "Scan_recent_reports_idx")
  // New indexes for Freemium features
  @@index([userId, createdAt(sort: Desc)], map: "Scan_user_history_idx")
  @@index([isPublic, createdAt(sort: Desc)], map: "Scan_public_reports_idx")
  @@index([scannerIp, createdAt(sort: Desc)], map: "Scan_ip_ratelimit_idx")
  // Domain Intelligence Engine: Index for volatility queries
  @@index([domainId, status, finishedAt(sort: Desc)], map: "Scan_domain_volatility_idx")
  // Analytics queries (status + score filtering)
  @@index([status, score], map: "Scan_analytics_idx")
}

model Evidence {
  id        String   @id @default(cuid())
  scanId    String
  kind      EvidenceKind
  severity  Int
  title     String
  details   Json
  createdAt DateTime @default(now())
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  // Covering index for optimal evidence queries and counting
  @@index([scanId, createdAt], map: "Evidence_scan_covering_idx")
  // Index for kind-based filtering (fingerprint detection, policy checks)
  @@index([kind, scanId], map: "Evidence_kind_scan_idx")
}

model Issue {
  id           String        @id @default(cuid())
  scanId       String
  key          String?
  severity     IssueSeverity
  category     String
  title        String
  summary      String?
  howToFix     String?
  whyItMatters String?
  references   Json?
  sortWeight   Int?          @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  scan         Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)

  // Covering index for optimal issue queries with proper sorting
  @@index([scanId, sortWeight, createdAt], map: "Issue_scan_covering_idx")
  @@index([severity, sortWeight], map: "Issue_severity_idx")
}

model CachedList {
  id        String   @id @default(cuid())
  source    String
  version   String
  fetchedAt DateTime @default(now())
  data      Json
}

// Rate limiting for anonymous and free tier users
model RateLimit {
  id         String   @id @default(cuid())
  identifier String // IP address or user ID
  scansCount Int      @default(0)
  date       String // YYYY-MM-DD format for daily tracking
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, date])
  @@index([identifier, date], map: "RateLimit_lookup_idx")
}

// Watched URLs for Pro users (monitoring and alerts)
model WatchedUrl {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  url            String
  lastScore      Int?
  lastChecked    DateTime?
  checkFrequency CheckFrequency @default(WEEKLY)
  alertOnChange  Boolean        @default(true)
  createdAt      DateTime       @default(now())

  @@unique([userId, url])
  @@index([lastChecked, checkFrequency], map: "WatchedUrl_schedule_idx")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tokenHash])
  @@index([userId, expiresAt], map: "PasswordResetToken_user_idx")
}

// Wallet authentication linking
model WalletLink {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store HASHED wallet address for linking only
  walletAddressHash String   @unique
  linkedAt          DateTime @default(now())
  lastVerified      DateTime @default(now())

  @@index([walletAddressHash])
}

// Blog post status enum
enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

// Blog posts for content marketing
model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  excerpt         String         @db.Text
  content         String         @db.Text
  coverImage      String?
  metaTitle       String?
  metaDescription String?        @db.Text
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  readTimeMinutes Int            @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Optimized indexes for blog queries
  @@index([status, publishedAt(sort: Desc)], map: "BlogPost_published_idx")
  @@index([slug], map: "BlogPost_slug_idx")
}

// Domain model for SEO canonical URLs (/privacy-policy/:domain)
model Domain {
  id           String    @id @default(cuid())
  domain       String    @unique // Normalized domain: "example.com"
  displayName  String? // Optional friendly name: "Example Inc"
  latestScanId String?   @unique // Most recent completed scan
  latestScan   Scan?     @relation("DomainLatestScan", fields: [latestScanId], references: [id], onDelete: SetNull)
  firstScanned DateTime? // When this domain was first scanned
  lastScanned  DateTime? // When the latest scan completed
  isIndexed    Boolean   @default(true) // Include in sitemap
  scanCount    Int       @default(0) // Total number of scans
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // === SEO Tier System (Phase 2A) ===
  // Tier A = MUST index (~5-7K), Tier B = eligible (~20-30K), Tier C = discovery only
  indexTier        IndexTier @default(C)
  tierScore        Int       @default(0) // Calculated priority score
  tierCalculatedAt DateTime? // When tier was last calculated
  tierRank         Int? // Position in tier score ranking (Tier A only)
  lastPromotedAt   DateTime? // When domain was promoted to higher tier
  lastDemotedAt    DateTime? // When domain was demoted to lower tier

  // GSC signals (for tier calculation)
  gscClicks      Int       @default(0)
  gscImpressions Int       @default(0)
  gscLastUpdated DateTime?

  // === Phase 2B: Category Classification ===
  category           Category? @relation(fields: [categoryId], references: [id])
  categoryId         String?
  categoryConfidence Float? // 0.0 - 1.0 confidence score
  classifiedAt       DateTime?
  classifiedBy       String? // "brand_match" | "pattern_match" | "manual"

  // === Phase 2B: Freshness/Rescan ===
  lastScannedAt    DateTime? // When domain was last successfully scanned
  scanScheduledAt  DateTime? // When next rescan is scheduled
  rescanPriority   Int       @default(0) // Higher = sooner

  // === Domain Intelligence Engine (Phase 3) ===
  // Scan eligibility (reversible - deprioritize, not exclude)
  eligibleForScan     Boolean   @default(true)
  eligibilityReason   String?   // e.g., "low_priority_tld:.xyz"
  eligibilityTaggedAt DateTime?

  // Tranco seeding for initial tier assignment
  trancoRank          Int?
  trancoLastUpdated   DateTime?

  // Historical peak (for conservative demotion protection)
  historicalPeakScore Int?
  historicalPeakDate  DateTime?

  // === Error-Weighted Confidence (Stabilization Sprint) ===
  scanConfidence      Float?    // 0.0–1.0, Laplace-smoothed beta mean
  scanSuccessCount    Int       @default(0)
  scanFailureCount    Int       @default(0)
  confidenceUpdatedAt DateTime?

  // === Anti-Thrash Tracking (Week 1 Hardening) ===
  lastTierChangedAt   DateTime?         // When tier last changed
  tierChangeCount30d  Int       @default(0) // Tier changes in last 30 days
  tierChangeCount90d  Int       @default(0) // Tier changes in last 90 days
  promotionConfidence Float?              // 0-1, based on sustained signals
  lastPromotionCheck  DateTime?           // When confidence was last calculated

  // GSC signal stability (weekly breakdown for confidence)
  gscClicksWeek1      Int       @default(0) // Most recent week
  gscClicksWeek2      Int       @default(0)
  gscClicksWeek3      Int       @default(0)
  gscClicksWeek4      Int       @default(0) // 4 weeks ago

  // GSC impressions for anti-spike guards (Fix 1: DIE Final Hardening)
  gscImpressionsWeek1 Int       @default(0)
  gscImpressionsWeek2 Int       @default(0)
  gscImpressionsWeek3 Int       @default(0)
  gscImpressionsWeek4 Int       @default(0)
  gscTopQueryShare    Float?    // % of clicks from top query (0-1)

  // Relations
  tierPromotions TierPromotion[]
  scans          Scan[]          @relation("DomainScans") // All scans for volatility analysis
  changes        DomainChange[]  // Phase 3: Change history
  stability      DomainStability? // Phase 3C: Stability scoring
  insights       Insight[]       // Phase 3C: Insights for this domain

  // Optimized indexes for domain lookups and sitemap generation
  @@index([domain], map: "Domain_lookup_idx")
  @@index([isIndexed, lastScanned(sort: Desc)], map: "Domain_sitemap_idx")
  @@index([indexTier, tierScore(sort: Desc)], map: "Domain_tier_idx")
  @@index([indexTier, tierRank], map: "Domain_tier_rank_idx")
  @@index([categoryId], map: "Domain_category_idx")
  // Domain Intelligence Engine indexes
  @@index([eligibleForScan], map: "Domain_eligible_idx")
  @@index([trancoRank], map: "Domain_tranco_idx")
  @@index([historicalPeakScore], map: "Domain_peak_score_idx")
  @@index([lastScannedAt, indexTier], map: "Domain_rescan_idx")
  // Anti-thrash indexes
  @@index([lastTierChangedAt], map: "Domain_tier_changed_idx")
  @@index([tierChangeCount90d], map: "Domain_thrash_idx")
}

// Scan queue status for bulk scanning operations
enum ScanQueueStatus {
  PENDING   // Not yet attempted
  QUEUED    // Added to BullMQ queue
  SUCCESS   // Scan completed successfully
  FAILED    // Scan failed (server error, parsing error)
  BLOCKED   // Site blocked our scanner (403, robots.txt)
  TIMEOUT   // Request timed out
  INVALID   // Invalid URL or unreachable
}

// Queue for bulk scanning operations (100k website scanning)
model ScanQueue {
  id            String          @id @default(cuid())
  domain        String          @unique // Normalized domain: "example.com"
  status        ScanQueueStatus @default(PENDING)
  priority      Int             @default(0) // Higher = scan first (top 10k = 100-90)
  source        String?         // Source list: "tranco", "alexa", "manual"
  sourceRank    Int?            // Rank in source list (1 = most popular)

  // Attempt tracking
  attemptCount  Int             @default(0)
  lastAttempt   DateTime?
  lastError     String?         // Error message from last attempt

  // Success tracking
  scanId        String?         // ID of successful scan
  score         Int?            // Privacy score from scan

  // Metadata
  batchId       String?         // Group scans by batch
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Optimized indexes for queue processing
  @@index([status, priority(sort: Desc)], map: "ScanQueue_process_idx")
  @@index([status, lastAttempt], map: "ScanQueue_retry_idx")
  @@index([batchId, status], map: "ScanQueue_batch_idx")
  @@index([source, sourceRank], map: "ScanQueue_source_idx")
}

// === SEO Phase 2A: Indexing Velocity Tracking ===
// Tracks daily indexing metrics to measure SEO health over time
model IndexingSnapshot {
  id String @id @default(cuid())

  // Snapshot date (one per day)
  date DateTime @db.Date

  // Tier counts
  tierACount Int @default(0)
  tierBCount Int @default(0)
  tierCCount Int @default(0)

  // Sitemap totals
  sitemapTotal Int @default(0) // tierACount + limited tierBCount

  // GSC data (import from GSC API or manual)
  gscIndexed    Int?
  gscNotIndexed Int?

  // Velocity metrics
  netChange Int @default(0) // vs previous day

  createdAt DateTime @default(now())

  @@unique([date])
}

// === Phase 2B: Category Classification ===
// Industry categories for domain grouping and benchmark pages
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique // "streaming", "ecommerce", "saas", "news"
  name        String // "Streaming & Media"
  description String?

  // Benchmarks (calculated weekly)
  // { avgScore, medianScore, avgTrackers, avgCookies, fingerprintingRate, sampleSize, scorePercentiles }
  benchmarks             Json?
  benchmarksCalculatedAt DateTime?

  // Relations
  domains           Domain[]
  sampleComparisons SampleComparison[]
  trends            CategoryTrend[] // Phase 3C: Category trends

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// === Sample Comparisons (UX only, NOT for SEO) ===
// Curated comparison pairs to help users understand the compare feature
// IMPORTANT: Never index, never add to sitemap, max 3 per category
model SampleComparison {
  id String @id @default(cuid())

  // Category relation
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Comparison pair
  domainA String // e.g., "bunnings.com.au"
  domainB String // e.g., "mitre10.com.au"

  // Display
  label       String  // e.g., "Hardware Stores (AU)"
  description String? // Optional: "Compare two Australian hardware retailers"

  // Ordering & visibility
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([active])
}

// === Phase 2B: Tier Promotion Tracking ===
// Audit log for tier changes (B→A, A→B promotions/demotions)
model TierPromotion {
  id       String @id @default(cuid())
  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  fromTier   String  // "B" or "C"
  toTier     String  // "A" or "B"
  reason     String  // "gsc_clicks", "gsc_impressions", "high_score", "demotion"
  confidence Float?  // Promotion confidence score at time of change

  createdAt DateTime @default(now())

  @@index([domainId])
  @@index([createdAt(sort: Desc)])
  @@index([toTier, createdAt(sort: Desc)])
}

// === Daily Operational Reports ===
model DailyReport {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  report    Json     // Full report JSON
  createdAt DateTime @default(now())
}

// === Phase 3: System State (Circuit Breaker, Scheduler State) ===
// Persistent key-value store for system state that survives restarts
model SystemState {
  key       String   @id // e.g., "circuit_breaker", "scheduler_lock"
  value     Json     // Arbitrary JSON value
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// === Phase 3: Scheduler Batch Tracking ===
// Ensures scheduling idempotency at DB level (not just lock files)
model SchedulerBatch {
  id            String   @id @default(cuid())
  batchDate     String   // YYYY-MM-DD - only one batch per day
  batchType     String   // "rescan" | "new_domains" | "promotion"

  // Execution tracking
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  status        BatchStatus @default(running)

  // Results
  scheduled     Int      @default(0)
  skipped       Int      @default(0)
  errors        Int      @default(0)

  // Metadata
  budgetUsed    Json?    // Budget allocation snapshot
  notes         String?

  @@unique([batchDate, batchType])
  @@index([batchDate])
  @@index([status])
}

// === Phase 3: Change Intelligence ===
// Tracks privacy changes between scans for a domain
model DomainChange {
  id                    String     @id @default(cuid())
  domainId              String
  domain                Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  scanId                String
  scan                  Scan       @relation("DomainChangeCurrentScan", fields: [scanId], references: [id], onDelete: Cascade)
  previousScanId        String
  previousScan          Scan       @relation("DomainChangePreviousScan", fields: [previousScanId], references: [id], onDelete: Cascade)

  // Score changes
  scoreBefore           Int
  scoreAfter            Int
  scoreDelta            Int

  // Tracker changes
  trackerCountBefore    Int
  trackerCountAfter     Int
  trackersAdded         String[]   @default([])
  trackersRemoved       String[]   @default([])

  // Fingerprinting changes
  fingerprintingBefore  Boolean    @default(false)
  fingerprintingAfter   Boolean    @default(false)
  fingerprintingChanged Boolean    @default(false)

  // Classification
  changeType            ChangeType @default(NONE)
  significanceScore     Float      @default(0)
  changeReasons         String[]   @default([])

  detectedAt            DateTime   @default(now())

  @@unique([domainId, scanId])
  @@index([domainId, detectedAt(sort: Desc)])
  @@index([changeType, detectedAt(sort: Desc)])
  @@index([significanceScore(sort: Desc)])
}

// === Phase 3C: Insight Engine ===

// Domain Stability Scoring
model DomainStability {
  id                    String      @id @default(cuid())
  domainId              String      @unique
  domain                Domain      @relation(fields: [domainId], references: [id], onDelete: Cascade)

  // Stability metrics
  volatilityIndex       Float       // 0-100, higher = more volatile
  stabilityScore        Float       // 0-100, higher = more stable

  // Trend classification
  trend                 DomainTrend
  trendStrength         Float       // 0-1, how strong is the trend

  // Historical averages
  avgScoreLast30d       Float
  avgScoreLast90d       Float
  scoreStdDev30d        Float
  scoreStdDev90d        Float

  // Change frequency
  changesLast30d        Int
  changesLast90d        Int
  majorChangesLast90d   Int

  // === Confidence Tier Validation (Phase 3C Observation) ===

  // Confidence tier at calculation time
  confidenceTier        StabilityConfidenceTier @default(PROVISIONAL)
  scanCount             Int                     @default(1)
  timeSpanDays          Int                     @default(0)

  // Validation tracking (was our confidence tier prediction correct?)
  tierAssignedAt        DateTime?               // When tier was assigned
  tierValidatedAt       DateTime?               // When validation occurred
  tierValidationResult  Boolean?                // Did tier prediction hold?
  actualVolatility      Float?                  // Actual volatility after observation
  tierAccurate          Boolean?                // Was tier classification accurate?

  calculatedAt          DateTime    @default(now())

  @@index([trend, stabilityScore])
  @@index([volatilityIndex(sort: Desc)])
  @@index([confidenceTier])
}

// Category Trend Analysis
model CategoryTrend {
  id                    String         @id @default(cuid())
  categoryId            String
  category              Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Period
  periodStart           DateTime
  periodEnd             DateTime
  periodType            PeriodType     // WEEKLY, MONTHLY

  // Score trends
  avgScore              Float
  avgScorePrevPeriod    Float
  scoreChange           Float          // Percentage change
  scoreTrend            TrendDirection

  // Tracker trends
  avgTrackerCount       Float
  avgTrackerCountPrev   Float
  trackerCountChange    Float
  trackerTrend          TrendDirection

  // Fingerprinting
  fingerprintingRate    Float          // % of domains using it
  fingerprintingRatePrev Float
  fingerprintingTrend   TrendDirection

  // Domain counts
  domainsImproving      Int
  domainsDeclining      Int
  domainsStable         Int

  // Top movers
  topImprovements       Json           // [{domainId, domain, delta}]
  topRegressions        Json           // [{domainId, domain, delta}]

  calculatedAt          DateTime       @default(now())

  @@unique([categoryId, periodStart, periodType])
  @@index([periodType, periodStart])
}

// Tracker Evolution Tracking
model TrackerTrend {
  id                    String         @id @default(cuid())

  // Tracker identifier
  trackerDomain         String         // e.g., "google-analytics.com"
  trackerName           String?        // e.g., "Google Analytics"
  trackerCategory       String?        // e.g., "Analytics", "Advertising"

  // Period
  periodStart           DateTime
  periodEnd             DateTime
  periodType            PeriodType

  // Adoption metrics
  domainCount           Int            // Domains using this tracker
  domainCountPrev       Int
  adoptionChange        Float          // Percentage change
  adoptionTrend         TrendDirection

  // By tier
  tierACount            Int
  tierBCount            Int
  tierCCount            Int

  // By category (top 5)
  topCategories         Json           // [{categoryId, count, change}]

  // New adoptions / removals this period
  newAdoptions          Int
  removals              Int
  netChange             Int

  calculatedAt          DateTime       @default(now())

  @@unique([trackerDomain, periodStart, periodType])
  @@index([adoptionTrend, adoptionChange])
  @@index([periodType, periodStart])
}

// Generated Insights
model Insight {
  id                    String          @id @default(cuid())

  // Classification
  insightType           InsightType
  severity              InsightSeverity

  // Content
  title                 String
  summary               String
  details               Json            // Structured data supporting the insight

  // Entities involved (optional references)
  domainId              String?
  domain                Domain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)
  categoryId            String?
  trackerDomain         String?

  // Period
  periodStart           DateTime
  periodEnd             DateTime

  // Metrics
  magnitude             Float           // How significant (0-100)
  confidence            Float           // How confident (0-1)

  // Publishing
  isPublishable         Boolean         @default(false)
  publishedAt           DateTime?

  // === Truth-Centric Metrics (Phase 3C Observation) ===

  // Outcome tracking (Truth Half-Life)
  outcome               InsightOutcome  @default(PENDING)
  outcomeDetails        String?         // Explanation of outcome
  outcomeValidatedAt    DateTime?       // When outcome was determined

  // Prediction tracking
  predictedOutcome      String?         // What the insight predicted
  actualOutcome         String?         // What actually happened

  // Truth half-life metrics
  confirmedAt           DateTime?       // When insight was confirmed
  reversedAt            DateTime?       // When insight was reversed
  supersededAt          DateTime?       // When replaced by newer insight
  supersededById        String?         // ID of superseding insight

  // Retraction tracking
  incorrectDetectedAt   DateTime?       // When incorrect outcome detected
  retractionPublishedAt DateTime?       // When retraction was published
  retractionLatencyHours Float?         // Hours between detection and retraction

  // Retraction visibility (hidden corrections = no corrections)
  retractionVisibleAt   DateTime?       // When retraction became visible in public feeds
  visibilityLagHours    Float?          // Hours between publish and visible (target: <12h)

  // Narrative governance
  narrative             String?         // Generated narrative text
  narrativeStatus       NarrativeStatus?
  narrativeScope        NarrativeScope?

  createdAt             DateTime        @default(now())

  @@index([insightType, createdAt])
  @@index([severity, createdAt])
  @@index([isPublishable, createdAt])
  @@index([domainId])
  @@index([outcome, createdAt])
  @@index([outcomeValidatedAt])
  @@index([narrativeStatus, createdAt])
}

// Weekly Privacy Reports
model WeeklyReport {
  id                    String    @id @default(cuid())

  weekStart             DateTime
  weekEnd               DateTime

  // Summary stats
  domainsScanned        Int
  changesDetected       Int
  avgScoreChange        Float

  // Highlights
  topImprovements       Json      // Top 10 improving domains
  topRegressions        Json      // Top 10 regressing domains

  // Category summary
  categorySummary       Json      // Per-category trends

  // Tracker summary
  trackerSummary        Json      // Top growing/declining trackers

  // Insights
  keyInsights           Json      // Auto-generated insights

  // Narrative (auto-generated)
  narrativeSummary      String?   // "This week, privacy improved across..."

  // Publishing
  isPublished           Boolean   @default(false)
  publishedAt           DateTime?

  createdAt             DateTime  @default(now())

  @@unique([weekStart])
}

// === Phase 3C Observation: Governance Enforcement Metrics ===
model GovernanceMetrics {
  id                    String    @id @default(cuid())

  // Period
  date                  DateTime  @unique  // Daily tracking

  // Narrative enforcement
  narrativesAttempted   Int       @default(0)  // Total narrative generations attempted
  narrativesBlocked     Int       @default(0)  // Blocked by hedge language rules
  narrativesApproved    Int       @default(0)  // Passed validation
  blockRate             Float     @default(0)  // % blocked

  // Hedge language violations
  forbiddenCausalCount  Int       @default(0)  // "caused by", "due to", etc.
  missingHedgeCount     Int       @default(0)  // Missing required hedge words
  overconfidentCount    Int       @default(0)  // Confidence level mismatches

  // Retraction governance
  retractionsAttempted  Int       @default(0)
  retractionsPassed     Int       @default(0)  // Passed tone validation
  retractionsFailed     Int       @default(0)  // Failed tone validation

  // Insight integrity
  insightsGenerated     Int       @default(0)
  insightsFailedQuality Int       @default(0)  // Below quality threshold
  insightsPublished     Int       @default(0)

  // Change detection metrics
  scansProcessed        Int       @default(0)
  scansWithNoChange     Int       @default(0)  // % producing no change
  changesBelow          Int       @default(0)  // Changes below threshold

  createdAt             DateTime  @default(now())

  @@index([date])
}

// === Phase 0: Transparency Reports (Authority Brand Infrastructure) ===

enum TransparencyReportStatus {
  DRAFT
  PUBLISHED
  UPDATED // Corrections post-publish, original preserved
}

model TransparencyReport {
  id            String                   @id @default(cuid())
  slug          String                   @unique // "2026-02" = month reported
  title         String
  status        TransparencyReportStatus @default(DRAFT)

  scheduledFor  DateTime // Always 1st of next month, 09:00 UTC
  publishedAt   DateTime?
  autoPublished Boolean  @default(false)

  // Immutable frozen snapshot. This IS the truth. No parallel version fields.
  metricsSnapshot Json

  // Content
  content       String   @db.Text
  quotables     String[] @default([])
  keyFinding    String? // Headline finding
  revisionNote  String? // For UPDATED reports

  // Methodology snapshot (immutable copy at publication time)
  methodologySnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt(sort: Desc)], map: "TransparencyReport_status_published_idx")
}

// === P0 #2: DDG Tracker Radar Shadow Mode ===
// Shadow tables for comparing DDG Tracker Radar data against production lists.
// Completely separate from production scoring - read-only comparison only.

model ShadowTrackerSource {
  id           String          @id @default(cuid())
  name         String          @unique // "ddg-tracker-radar", "disconnect", etc.
  version      String                  // Commit hash or date string
  lastUpdated  DateTime
  trackerCount Int
  metadata     Json?                   // Source-specific metadata
  createdAt    DateTime        @default(now())
  trackers     ShadowTracker[]
}

model ShadowTracker {
  id             String              @id @default(cuid())
  sourceId       String
  domain         String
  owner          String?             // Entity that owns this tracker
  category       String?             // "Analytics", "Advertising", etc.
  prevalence     Float?              // 0-1, how common across the web
  fingerprinting Int?                // DDG fingerprinting score 0-3
  cookies        Float?              // Cookie usage metric
  metadata       Json?               // Additional source-specific data
  createdAt      DateTime            @default(now())
  source         ShadowTrackerSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([domain])
  @@index([sourceId])
}

model ShadowScoreComparison {
  id                 String   @id @default(cuid())
  scanId             String
  domainId           String
  productionScore    Int
  productionTrackers Int
  shadowScore        Int      // What score would be with shadow data
  shadowTrackers     Int      // How many trackers shadow source found
  scoreDelta         Int      // shadow - production
  trackerDelta       Int      // shadow trackers - production trackers
  newTrackersFound   Json?    // Trackers found by shadow but not production
  createdAt          DateTime @default(now())

  @@index([scanId])
  @@index([domainId])
}

// === Lead Capture: API Sample Requests ===
model SampleRequest {
  id        String   @id @default(cuid())
  domain    String
  email     String
  fulfilled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([fulfilled])
}
