# Next.js SSR app for SEO pages
# Uses standalone output for minimal image size

# Stage 1: Build
FROM node:22-slim AS builder
WORKDIR /app
ENV CI=true
ENV NEXT_TELEMETRY_DISABLED=1

# Copy everything and build
COPY . .
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install -r --frozen-lockfile
RUN pnpm --filter @gecko-advisor/shared build && pnpm --filter @gecko-advisor/web build

# Stage 2: Production
FROM node:22-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone server (includes all necessary files)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./

# Copy static files to correct location
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs

EXPOSE 3000

# Force port 3000 regardless of inherited PORT env var
ENV HOSTNAME="0.0.0.0"

# Server.js is at apps/web/server.js in monorepo standalone output
# Explicitly set PORT=3000 to override any inherited value
CMD ["sh", "-c", "PORT=3000 node apps/web/server.js"]
