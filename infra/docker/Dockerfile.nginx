# Nginx reverse proxy for Gecko Advisor
# Routes /api/* to backend, everything else to Next.js web app

FROM nginx:1.27-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy nginx configuration template
COPY infra/docker/nginx.tmpl.conf /nginx.tmpl.conf
COPY infra/docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
