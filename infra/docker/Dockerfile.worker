# ==============================================================================
# Dockerfile.worker - BullMQ job processor
# Multi-stage build: deps -> build -> runner
# Compiles TypeScript to JavaScript for production (no tsx runtime overhead)
# ==============================================================================

# ---------- Stage 1: Install all dependencies ----------
FROM node:22-slim AS deps
WORKDIR /app
ENV CI=true

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

# Copy workspace config and lockfile first for cache efficiency
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Copy package.json files for each workspace member needed by the worker
COPY apps/backend/package.json apps/backend/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY infra/prisma/package.json infra/prisma/

# Copy Prisma schema (needed by postinstall hooks that run prisma generate)
COPY infra/prisma/schema.prisma infra/prisma/

# Install all dependencies (including devDependencies for building)
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ---------- Stage 2: Build TypeScript to JavaScript ----------
FROM deps AS build
WORKDIR /app

# Copy source code
COPY packages/shared/ packages/shared/
COPY apps/worker/ apps/worker/
COPY infra/prisma/ infra/prisma/

# Generate Prisma client and compile TypeScript
RUN pnpm prisma:generate && pnpm turbo run build --filter=@gecko-advisor/worker...

# Create a pruned production deployment with only production dependencies
# pnpm deploy copies the package + production node_modules into a self-contained directory
RUN pnpm deploy --filter=@gecko-advisor/worker --prod --legacy /app/pruned/worker

# ---------- Stage 3: Production runner ----------
FROM node:22-slim AS runner
ENV NODE_ENV=production
WORKDIR /app

# Install runtime system dependencies
# - openssl: required by Prisma for database connections
# - tini: proper PID 1 init for signal handling
# - chromium: headless browser for JS-loaded tracker detection via puppeteer-core
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    openssl tini chromium \
    && rm -rf /var/lib/apt/lists/*

# Tell puppeteer-core where to find the system Chromium binary
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Skip Chromium download — we use the system package above
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Copy pruned production node_modules and compiled worker
COPY --from=build /app/pruned/worker/node_modules ./node_modules
COPY --from=build /app/apps/worker/dist ./dist

# Copy the built shared package (workspace dependency)
COPY --from=build /app/packages/shared/dist ./node_modules/@gecko-advisor/shared/dist
COPY --from=build /app/packages/shared/package.json ./node_modules/@gecko-advisor/shared/

# Copy generated Prisma client (lives in node_modules)
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma/client ./node_modules/@prisma/client

# Copy data files needed at runtime (fallback lists loaded via process.cwd())
COPY packages/shared/data ./packages/shared/data

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

USER appuser

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/apps/worker/src/index.js"]
