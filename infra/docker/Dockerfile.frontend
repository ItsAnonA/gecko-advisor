FROM node:22-alpine AS builder
WORKDIR /app
ENV CI=true
COPY . .
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install -r --frozen-lockfile
# Build only shared and frontend packages (skip web to avoid Google Fonts fetch issues on ARM64)
RUN pnpm --filter @gecko-advisor/shared run build && pnpm --filter @gecko-advisor/frontend run build

FROM nginx:1.27-alpine AS runner
WORKDIR /usr/share/nginx/html
COPY --from=builder /app/apps/frontend/dist .
WORKDIR /
COPY infra/docker/nginx.tmpl.conf /nginx.tmpl.conf
COPY infra/docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
