FROM node:22-alpine AS builder
WORKDIR /app
ENV CI=true
# PNPM_FILTER: If set, only install deps for specified package (faster builds)
ARG PNPM_FILTER=""
COPY . .
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    if [ -n "$PNPM_FILTER" ]; then \
      pnpm --filter "$PNPM_FILTER" install --frozen-lockfile; \
    else \
      pnpm install -r --frozen-lockfile; \
    fi
RUN pnpm -w --filter @gecko-advisor/shared build && pnpm -w --filter @gecko-advisor/frontend build

FROM nginx:1.27-alpine AS runner
WORKDIR /usr/share/nginx/html
COPY --from=builder /app/apps/frontend/dist .
WORKDIR /
COPY infra/docker/nginx.tmpl.conf /nginx.tmpl.conf
COPY infra/docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
