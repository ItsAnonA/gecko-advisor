# ==============================================================================
# Dockerfile.backend - Express API server
# Multi-stage build: deps -> build -> runner
# Compiles TypeScript to JavaScript for production (no tsx runtime overhead)
# ==============================================================================

# ---------- Stage 1: Install all dependencies ----------
FROM node:22-slim AS deps
WORKDIR /app
ENV CI=true

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

# Copy workspace config and lockfile first for cache efficiency
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Copy package.json files for each workspace member needed by the backend
COPY apps/backend/package.json apps/backend/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY infra/prisma/package.json infra/prisma/

# Copy Prisma schema (needed by postinstall hooks that run prisma generate)
COPY infra/prisma/schema.prisma infra/prisma/

# Install all dependencies (including devDependencies for building)
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ---------- Stage 2: Build TypeScript to JavaScript ----------
FROM deps AS build
WORKDIR /app

# Copy source code
COPY packages/shared/ packages/shared/
COPY apps/backend/ apps/backend/
COPY infra/prisma/ infra/prisma/

# Generate Prisma client and compile TypeScript
RUN pnpm prisma:generate && pnpm turbo run build --filter=@gecko-advisor/backend...

# Create a pruned production deployment with only production dependencies
# pnpm deploy copies the package + production node_modules into a self-contained directory
RUN pnpm deploy --filter=@gecko-advisor/backend --prod --legacy /app/pruned/backend

# Resolve pnpm symlinks for Prisma CLI packages needed at runtime (prisma migrate deploy)
# pnpm uses symlinks in node_modules; cp -rL dereferences them into real files
# NOTE: @prisma/client is already in pruned node_modules (production dep), so skip it here
#       to avoid COPY conflicts. Only copy CLI deps (engines, debug, get-platform, etc.)
RUN mkdir -p /prisma-deps/@prisma && \
    cp -rL node_modules/.prisma /prisma-deps/.prisma && \
    cp -rL node_modules/prisma /prisma-deps/prisma && \
    for pkg in node_modules/.pnpm/node_modules/@prisma/*; do \
      name=$(basename "$pkg"); \
      [ "$name" = "client" ] && continue; \
      cp -rL "$pkg" "/prisma-deps/@prisma/$name"; \
    done

# ---------- Stage 3: Production runner ----------
FROM node:22-slim AS runner
ENV NODE_ENV=production
WORKDIR /app

# Install runtime system dependencies
# - openssl: required by Prisma for database connections
# - tini: proper PID 1 init for signal handling
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl tini \
    && rm -rf /var/lib/apt/lists/*

# Copy pruned production node_modules and compiled backend
COPY --from=build /app/pruned/backend/node_modules ./node_modules
COPY --from=build /app/apps/backend/dist ./dist

# Copy the built shared package (workspace dependency)
COPY --from=build /app/packages/shared/dist ./node_modules/@gecko-advisor/shared/dist
COPY --from=build /app/packages/shared/package.json ./node_modules/@gecko-advisor/shared/

# Copy Prisma schema + migrations (needed for prisma migrate deploy)
COPY --from=build /app/infra/prisma ./infra/prisma

# Copy Prisma packages for runtime and migrations (resolved from pnpm symlinks in build stage)
# .prisma: generated client with query engine binary
COPY --from=build /prisma-deps/.prisma ./node_modules/.prisma
# @prisma/*: engines, client, debug, get-platform, fetch-engine, etc.
COPY --from=build /prisma-deps/@prisma ./node_modules/@prisma
# prisma: CLI binary for `prisma migrate deploy` in entrypoint
COPY --from=build /prisma-deps/prisma ./node_modules/prisma

# Copy data files needed at runtime (fallback lists loaded via process.cwd())
COPY packages/shared/data ./packages/shared/data

# Copy OpenAPI spec (served by /docs endpoint) - static file, copy from context
COPY infra/openapi.yaml ./infra/openapi.yaml

# Copy entrypoint script
COPY infra/docker/backend-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

# Prisma migrate deploy needs write access to @prisma/engines for engine binaries
RUN chown -R appuser:nodejs node_modules/@prisma/engines node_modules/.prisma node_modules/prisma

USER appuser

EXPOSE 5000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/entrypoint.sh"]
